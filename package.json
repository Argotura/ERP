{
  "name": "cargoturo-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dashboard": "npm --prefix dashboard run dev",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "build:erp": "tsc -b && vite build",
    "build:dashboard": "npm --prefix dashboard run build:subpath",
    "build": "tsc -b && vite build && npm --prefix dashboard run build:subpath",
    "build:all": "npm run build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "workspaces": [
    "dashboard"
  ],
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
